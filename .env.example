# Nirzevis environment settings
# Copy this file to .env and adjust the values. Keep API keys private.
# Priority: command-line options > existing environment > .env > defaults.


# Whisper CLI settings (mandatory)
WHISPER_CLI=/absolute/path/to/whisper-cli
MODEL_PATH=/absolute/path/to/ggml-medium.en.bin
LANGUAGE=en
DTW_MODEL=medium.en

# LLM api settings (optional)
OPENAI_BASE_URL=http://127.0.0.1:8000/v1
OPENAI_MODEL=
OPENAI_API_KEY=


# Translation settings
TARGET_LANGUAGE=fa
TRANSLATION_BATCH_SIZE=8
OUTPUT_DIR=

# Booleans (accept true/false/1/0/yes/no); CLI --no-<name> overrides an enabled setting.
SKIP_TRANSCRIPTION=false
SKIP_TRANSLATION=true
REFRESH_TRANSLATIONS=false

# AUDIO_FILE can replace the positional audio argument.
# AUDIO_FILE=
